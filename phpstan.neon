includes:
    - vendor/larastan/larastan/extension.neon
    # Legacy debt is explicit and can only shrink; new errors fail CI.
    - phpstan-baseline.neon

parameters:
    level: 3
    paths:
        - app

    # Analysis only — no code changes are driven by this config.
    # Raise memory if the 338-file app OOMs during analysis.
    tmpDir: storage/phpstan
