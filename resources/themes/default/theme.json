{
    "key": "default",
    "name": "Default",
    "version": "1.0.0",
    "author": "Sellchaze",
    "category": "general",
    "min_platform_version": "1.0.0",
    "preview_image": null,

    "settings_schema": [
        {
            "id": "colors",
            "label": "Colors",
            "fields": [
                { "id": "primary", "type": "color", "label": "Primary", "default": "#2563eb" },
                { "id": "background", "type": "color", "label": "Background", "default": "#ffffff" },
                { "id": "text", "type": "color", "label": "Text", "default": "#0f172a" }
            ]
        },
        {
            "id": "typography",
            "label": "Typography",
            "fields": [
                { "id": "font", "type": "select", "label": "Font family", "default": "system", "options": ["system", "serif", "mono"] }
            ]
        },
        {
            "id": "layout",
            "label": "Layout",
            "fields": [
                { "id": "products_per_row", "type": "range", "label": "Products per row", "default": 4, "min": 2, "max": 6 },
                { "id": "show_categories", "type": "toggle", "label": "Show categories on home", "default": true }
            ]
        }
    ],

    "sections_schema": {
        "hero": {
            "label": "Hero",
            "settings": [
                { "id": "headline", "type": "text", "label": "Headline", "default": "" },
                { "id": "show_tagline", "type": "toggle", "label": "Show tagline", "default": true }
            ]
        },
        "category-list": {
            "label": "Category list",
            "settings": [
                { "id": "limit", "type": "number", "label": "Max categories", "default": 12 }
            ]
        },
        "product-grid": {
            "label": "Product grid",
            "settings": [
                { "id": "limit", "type": "number", "label": "Max products", "default": 8 },
                { "id": "featured_only", "type": "toggle", "label": "Featured only", "default": true }
            ]
        },
        "category-header": {
            "label": "Category header",
            "settings": []
        },
        "product-details": {
            "label": "Product details",
            "settings": []
        },
        "rich-text": {
            "label": "Rich text",
            "settings": [
                { "id": "content", "type": "richtext", "label": "Content", "default": "" }
            ]
        }
    },

    "templates": {
        "home": {
            "sections": [
                { "type": "hero" },
                { "type": "category-list" },
                { "type": "product-grid", "settings": { "limit": 8, "featured_only": true } }
            ]
        },
        "product": {
            "sections": [
                { "type": "product-details" }
            ]
        },
        "category": {
            "sections": [
                { "type": "category-header" },
                { "type": "product-grid", "settings": { "featured_only": false } }
            ]
        }
    }
}
